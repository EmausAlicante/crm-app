# Copia este archivo a .env.local y pon aquí la connection string de tu proyecto Neon
# (Dashboard de Neon → Connection string). Debe empezar por postgresql://
DATABASE_URL="postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Opcional: envío del resumen diario por email (acciones vencidas/que vencen hoy).
# Sin esto configurado, el cron diario no hace nada (no falla).
# 1. Crea una cuenta gratuita en https://resend.com y genera una API key.
# 2. Pon aquí esa clave. El email destino se configura en Configuración → Avisos.
RESEND_API_KEY=""
# Opcional: remitente personalizado (por defecto usa el dominio de pruebas de Resend).
RESEND_FROM_EMAIL="CRM MATIC <onboarding@resend.dev>"
# Opcional pero recomendado: protege /api/cron/daily-digest de invocaciones externas.
# Si lo defines aquí, Vercel Cron lo envía automáticamente como Bearer token.
CRON_SECRET=""
